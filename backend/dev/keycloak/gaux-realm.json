{
  "realm": "gaux",
  "displayName": "GauX",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 2592000,
  "ssoSessionMaxLifespan": 7776000,
  "offlineSessionIdleTimeout": 2592000,
  "clients": [
    {
      "clientId": "gaux-app",
      "name": "GauX mobile app",
      "description": "Public client for the Flutter app: Authorization Code with PKCE only.",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["za.co.gaux.app:/oauthredirect"],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "za.co.gaux.app:/oauthredirect"
      },
      "protocolMappers": [
        {
          "name": "gaux-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "gaux-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "gaux-api",
      "name": "GauX API",
      "description": "The backend. Exists only so access tokens can name it as their audience.",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    },
    {
      "clientId": "gaux-dev-cli",
      "name": "Development tools (DEV REALM ONLY)",
      "description": "Password grant for tests and curl. Never create this client in a production realm.",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "protocolMappers": [
        {
          "name": "gaux-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "gaux-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "judge@gaux.co.za",
      "email": "judge@gaux.co.za",
      "emailVerified": true,
      "firstName": "Hackathon",
      "lastName": "Judge",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "Hackathon2026!",
          "temporary": false
        }
      ]
    }
  ]
}
